# Copy to .env on the collector VM. Use absolute paths; never commit .env.
CLOUDSCOPE_UID=1000
CLOUDSCOPE_GID=1000
CLOUDSCOPE_BIND_IP=127.0.0.1
CLOUDSCOPE_ALLOWED_ORIGINS=http://127.0.0.1:5173
CLOUDSCOPE_AWS_CONFIG_FILE=/home/cloudscope/.aws/config
CLOUDSCOPE_SIGNING_HELPER=/opt/cloudscope/bin/aws_signing_helper
CLOUDSCOPE_COLLECTOR_CERT=/opt/cloudscope/pki/collector.crt
CLOUDSCOPE_COLLECTOR_KEY=/opt/cloudscope/pki/collector.key
